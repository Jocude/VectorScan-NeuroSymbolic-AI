<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.VectorScan" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">#1565C0</item>
        <item name="colorPrimaryVariant">#0D47A1</item>
        <item name="colorOnPrimary">#FFFFFF</item>
        <item name="colorSecondary">#42A5F5</item>
        <item name="colorSecondaryVariant">#1E88E5</item>
        <item name="colorOnSecondary">#000000</item>
        <item name="android:statusBarColor">#0D47A1</item>
    </style>

    <!-- Vista de realidad aumentada: la cámara ocupa toda la pantalla. -->
    <style name="Theme.VectorScan.Fullscreen">
        <item name="android:windowFullscreen">true</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
    </style>
</resources>
